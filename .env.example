# Optional overrides. Copy to .env (npm start and npm run dev read it).
# Everything here can also be set in the deck's Settings page instead.

# Port and interface the deck listens on.
# PORT=3325
# HOST=0.0.0.0

# obs-websocket connection. When either is set, the Settings page can't change it.
# OBS_URL=ws://127.0.0.1:4455
# OBS_PASSWORD=

# Where deck.json, settings.json and uploaded images live.
# STREAMDECK_DATA_DIR=./data

# debug | info | warn | error
# LOG_LEVEL=info
